<?xml version="1.0" encoding="UTF-8"?>
<completions>
	<provider name="julia">
		<syntax>julia</syntax>
		
		<completion trigger="function">
			<behavior>
				<append> ${1:name}(${2:args})&#10;&#9;${3:body}&#10;end</append>
			</behavior>
			<description>Function definition</description>
		</completion>

		<completion trigger="struct">
			<behavior>
				<append> ${1:Name}&#10;&#9;${2:field}::${3:Type}&#10;end</append>
			</behavior>
			<description>Struct definition</description>
		</completion>

		<completion trigger="for">
			<behavior>
				<append> ${1:i} in ${2:iter}&#10;&#9;${3:body}&#10;end</append>
			</behavior>
			<description>For loop</description>
		</completion>

		<completion trigger="if">
			<behavior>
				<append> ${1:condition}&#10;&#9;${2:body}&#10;end</append>
			</behavior>
			<description>If statement</description>
		</completion>
	</provider>
</completions>
